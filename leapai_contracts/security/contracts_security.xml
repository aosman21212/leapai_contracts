<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Module Privilege (Odoo 19 replaces ir.module.category) ─────────── -->
    <record model="res.groups.privilege" id="res_groups_privilege_contracts">
        <field name="name">Unified Contracts System</field>
        <field name="sequence">55</field>
        <field name="category_id" ref="base.module_category_customization"/>
    </record>

    <!-- ── Security Groups ────────────────────────────────────────────────── -->
    <record id="group_contracts_user" model="res.groups">
        <field name="name">User — مستخدم</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_contracts"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view and manage contract records.</field>
    </record>

    <record id="group_contracts_manager" model="res.groups">
        <field name="name">Manager — مدير</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_contracts"/>
        <field name="implied_ids" eval="[(4, ref('leapai_contracts.group_contracts_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to all contract features including approval and deletion.</field>
    </record>

</odoo>
