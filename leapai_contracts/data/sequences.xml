<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_contract_tender" model="ir.sequence">
            <field name="name">Contract Tender</field>
            <field name="code">contract.tender</field>
            <field name="prefix">TND-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_contract_bid" model="ir.sequence">
            <field name="name">Contract Bid</field>
            <field name="code">contract.bid</field>
            <field name="prefix">BID-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_contract_contract" model="ir.sequence">
            <field name="name">Contract</field>
            <field name="code">contract.contract</field>
            <field name="prefix">CON-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_contract_amendment" model="ir.sequence">
            <field name="name">Contract Amendment</field>
            <field name="code">contract.amendment</field>
            <field name="prefix">AMD-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_contract_payment_certificate" model="ir.sequence">
            <field name="name">Payment Certificate</field>
            <field name="code">contract.payment.certificate</field>
            <field name="prefix">IPC-%(year)s-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
